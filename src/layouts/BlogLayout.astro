---
interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  slug?: string;
}
const { title, description, date, tags, slug } = Astro.props;
const ogDescription = description || "Ryan Hughes — Builder, founder, open-source contributor.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="description" content={ogDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://ryanhughes.me/blog/${slug || ''}`} />
    <meta property="og:image" content="https://ryanhughes.me/images/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ryanrhughes" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://ryanhughes.me/images/og-image.png" />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="3d0168ef-9391-4259-b568-a49b112e5574"></script>
    <title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap');

      :root {
        --tn-bg: #1a1b26;
        --tn-bg-dark: #16161e;
        --tn-fg: #a9b1d6;
        --tn-cyan: #7dcfff;
        --tn-green: #9ece6a;
        --tn-red: #f7768e;
        --tn-yellow: #e0af68;
        --tn-purple: #bb9af7;
        --tn-blue: #7aa2f7;
        --tn-orange: #ff9e64;
        --tn-comment: #565f89;
        --tn-selection: #33467c;
      }

      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--tn-bg);
        color: var(--tn-fg);
        font-family: 'JetBrains Mono', monospace;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background: var(--tn-bg);
      }

      ::selection {
        background: var(--tn-selection);
        color: white;
      }

      .blog-container {
        max-width: 680px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      /* Navigation */
      .blog-nav {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 3rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(125, 207, 255, 0.1);
        font-size: 0.85rem;
      }

      .blog-nav a {
        color: var(--tn-cyan);
        text-decoration: none;
        transition: color 0.15s;
      }

      .blog-nav a:hover {
        color: #b4e1ff;
        text-shadow: 0 0 8px rgba(125, 207, 255, 0.4);
      }

      .blog-nav .prompt {
        color: var(--tn-comment);
      }

      /* Post header */
      .post-meta {
        margin-bottom: 2.5rem;
      }

      .post-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #c0caf5;
        line-height: 1.3;
        margin-bottom: 0.75rem;
        font-family: 'JetBrains Mono', monospace;
      }

      .post-date {
        color: var(--tn-comment);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
      }

      .post-description {
        color: var(--tn-fg);
        font-size: 0.95rem;
        line-height: 1.7;
        opacity: 0.8;
      }

      .post-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
      }

      .post-tag {
        font-size: 0.75rem;
        color: var(--tn-green);
        background: rgba(158, 206, 106, 0.08);
        border: 1px solid rgba(158, 206, 106, 0.2);
        padding: 0.15rem 0.6rem;
        border-radius: 3px;
      }

      /* Article body */
      .blog-content {
        line-height: 1.8;
        font-size: 0.95rem;
        color: var(--tn-fg);
      }

      .blog-content h2 {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--tn-purple);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-family: 'JetBrains Mono', monospace;
      }

      .blog-content h3 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--tn-blue);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
      }

      .blog-content p {
        margin-bottom: 1.25rem;
      }

      .blog-content a {
        color: var(--tn-cyan);
        text-decoration: underline;
        text-decoration-style: dotted;
        text-underline-offset: 3px;
        transition: all 0.15s;
      }

      .blog-content a:hover {
        color: #b4e1ff;
        text-shadow: 0 0 8px rgba(125, 207, 255, 0.4);
        text-decoration-style: solid;
      }

      .blog-content strong {
        color: #c0caf5;
        font-weight: 600;
      }

      .blog-content em {
        color: var(--tn-yellow);
        font-style: italic;
      }

      .blog-content code {
        font-family: 'JetBrains Mono', monospace;
        background: var(--tn-bg-dark);
        color: var(--tn-green);
        padding: 0.15em 0.4em;
        border-radius: 3px;
        font-size: 0.88em;
      }

      .blog-content pre {
        background: var(--tn-bg-dark);
        border: 1px solid var(--tn-selection);
        border-radius: 4px;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        line-height: 1.6;
      }

      .blog-content pre code {
        background: none;
        padding: 0;
        border-radius: 0;
      }

      .blog-content blockquote {
        border-left: 3px solid var(--tn-purple);
        padding-left: 1rem;
        color: var(--tn-comment);
        margin-bottom: 1.25rem;
        font-style: italic;
      }

      .blog-content ul, .blog-content ol {
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
      }

      .blog-content li {
        margin-bottom: 0.5rem;
      }

      .blog-content li::marker {
        color: var(--tn-cyan);
      }

      .blog-content hr {
        border: none;
        border-top: 1px solid var(--tn-selection);
        margin: 2rem 0;
      }

      .blog-content img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        margin: 1rem 0;
      }

      /* Terminal easter egg */
      .terminal-easter-egg {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(125, 207, 255, 0.1);
        font-size: 0.8rem;
        color: var(--tn-comment);
      }

      .terminal-easter-egg code {
        font-family: 'JetBrains Mono', monospace;
        background: var(--tn-bg-dark);
        color: var(--tn-green);
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }

      .terminal-easter-egg a {
        color: var(--tn-cyan);
        text-decoration: none;
      }

      .terminal-easter-egg a:hover {
        text-shadow: 0 0 8px rgba(125, 207, 255, 0.4);
      }

      /* Blog index styles */
      .blog-header {
        margin-bottom: 2.5rem;
      }

      .blog-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #c0caf5;
        font-family: 'JetBrains Mono', monospace;
      }

      .blog-header p {
        color: var(--tn-comment);
        margin-top: 0.5rem;
        font-size: 0.9rem;
      }

      .post-list {
        list-style: none;
      }

      .post-list-item {
        padding: 1.25rem 0;
        border-bottom: 1px solid rgba(125, 207, 255, 0.06);
      }

      .post-list-item:first-child {
        border-top: 1px solid rgba(125, 207, 255, 0.06);
      }

      .post-list-item a {
        text-decoration: none;
        display: block;
      }

      .post-list-item a:hover .post-list-title {
        color: var(--tn-cyan);
        text-shadow: 0 0 8px rgba(125, 207, 255, 0.3);
      }

      .post-list-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #c0caf5;
        transition: all 0.15s;
        margin-bottom: 0.35rem;
      }

      .post-list-date {
        font-size: 0.8rem;
        color: var(--tn-comment);
        margin-bottom: 0.35rem;
      }

      .post-list-desc {
        font-size: 0.88rem;
        color: var(--tn-fg);
        opacity: 0.7;
        line-height: 1.6;
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: var(--tn-comment); border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: #737aa2; }

      @media (max-width: 640px) {
        .blog-container {
          padding: 1.25rem 1rem 3rem;
        }

        .post-title {
          font-size: 1.4rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="blog-container">
      <slot />
    </div>
  </body>
</html>
