---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';

// This catch-all renders the terminal for any non-blog path
// Blog paths (/blog, /blog/*) are handled by their own pages

const path = Astro.params.path || '';

// Fetch blog posts at build time (same as index.astro)
const blogPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const blogJson = JSON.stringify(blogPosts.map(post => ({
  slug: post.id.replace(/\.md$/, ''),
  title: post.data.title,
  date: post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  description: post.data.description,
  tags: post.data.tags,
  body: post.body,
})));

// Fetch podcast RSS at build time
let podcastJson = 'null';
try {
  const res = await fetch('https://api.riverside.fm/hosting/okuCkBP9.rss');
  if (res.ok) {
    const xml = await res.text();

    function xmlText(source: string, tag: string): string {
      const cdataRe = new RegExp(`<${tag}[^>]*><!\\[CDATA\\[([\\s\\S]*?)\\]\\]></${tag}>`, 'i');
      const cdataMatch = source.match(cdataRe);
      if (cdataMatch) return cdataMatch[1];
      const re = new RegExp(`<${tag}[^>]*>(.*?)</${tag}>`, 'is');
      const match = source.match(re);
      return match ? match[1].trim() : '';
    }

    function xmlAttr(source: string, tag: string, attr: string): string {
      const re = new RegExp(`<${tag}[^>]*\\s${attr}="([^"]*)"`, 'i');
      const match = source.match(re);
      return match ? match[1] : '';
    }

    function slugify(title: string): string {
      return title.toLowerCase().replace(/^episode\s*\d+\s*[-–—]\s*/i, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 50).replace(/-$/, '');
    }

    function stripHtml(html: string): string {
      return html.replace(/<[^>]*>/g, '').trim();
    }

    function formatDate(dateStr: string): string {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return 'Unknown';
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
    }

    function formatDuration(dur: string): string {
      const parts = dur.split(':').map(Number);
      if (parts.length === 3) {
        const [h, m] = parts;
        return h > 0 ? `${h}h ${m}m` : `${m} min`;
      }
      return dur;
    }

    function parseChapters(html: string): { time: string; title: string }[] {
      const chapters: { time: string; title: string }[] = [];
      const regex = /(\d{1,2}:\d{2}(?::\d{2})?)\s+(.+?)(?:<\/|$)/g;
      let m;
      while ((m = regex.exec(html)) !== null) {
        chapters.push({ time: m[1], title: m[2].replace(/<[^>]*>/g, '').trim() });
      }
      return chapters;
    }

    function extractSummary(desc: string): string {
      const summaryMatch = desc.match(/<b>Summary<\/b><\/p><p>(.*?)<\/p>/s);
      if (summaryMatch) return stripHtml(summaryMatch[1]);
      const firstP = desc.match(/<p>(?!<b>)(.*?)<\/p>/s);
      if (firstP) return stripHtml(firstP[1]);
      return stripHtml(desc).slice(0, 300);
    }

    const channelTitle = xmlText(xml, 'title');
    const channelDesc = stripHtml(xmlText(xml, 'description')).split('.').slice(0, 2).join('.') + '.';
    const author = xmlText(xml, 'itunes:author');
    const imageUrl = xmlAttr(xml, 'itunes:image', 'href');

    const items = xml.split('<item>').slice(1);
    const episodes = items.map(item => {
      const title = xmlText(item, 'title');
      const desc = xmlText(item, 'description');
      const pubDate = xmlText(item, 'pubDate');
      const duration = xmlText(item, 'itunes:duration');
      const audioUrl = xmlAttr(item, 'enclosure', 'url');
      const epNumber = Number(xmlText(item, 'itunes:episode')) || 0;
      return {
        title, slug: slugify(title), number: epNumber, description: desc,
        summary: extractSummary(desc), chapters: parseChapters(desc),
        pubDate: formatDate(pubDate), duration: formatDuration(duration), audioUrl,
      };
    }).sort((a, b) => a.number - b.number);

    podcastJson = JSON.stringify({ title: channelTitle, description: channelDesc, author, imageUrl, episodes });
  }
} catch (e) {
  console.error('Podcast RSS fetch failed:', e);
}

// Generate pages for known filesystem paths
export async function getStaticPaths() {
  // Static terminal paths
  const paths = [
    'about', 'about/bio', 'about/dogs', 'about/dogs/remus', 'about/dogs/arthas',
    'projects', 'projects/oodle', 'projects/sunset-villas', 'projects/omarchy', 'projects/third-helix',
    'connect', 'connect/email', 'connect/linkedin', 'connect/github', 'connect/x',
    'resume',
    'podcast',
    'podcast/readme',
    'blog',
  ];

  // Fetch podcast episode slugs for deep-linking
  try {
    const res = await fetch('https://api.riverside.fm/hosting/okuCkBP9.rss');
    if (res.ok) {
      const xml = await res.text();
      const items = xml.split('<item>').slice(1);
      for (const item of items) {
        const titleMatch = item.match(/<title[^>]*>(?:<!\[CDATA\[)?(.*?)(?:\]\]>)?<\/title>/is);
        if (titleMatch) {
          const slug = titleMatch[1].toLowerCase()
            .replace(/^episode\s*\d+\s*[-–—]\s*/i, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '')
            .slice(0, 50)
            .replace(/-$/, '');
          paths.push(`podcast/${slug}`);
        }
      }
    }
  } catch (e) {
    console.warn('Failed to fetch podcast slugs for static paths:', e);
  }

  return paths.map(p => ({ params: { path: p } }));
}
---

<Layout title="Ryan Hughes">
  <div id="crt-overlay"></div>
  <div id="terminal" class="terminal-fullscreen">
    <div id="terminal-output" class="terminal-output" role="log" aria-live="polite"></div>
    <div id="bottom-bar" class="bottom-bar">
    <div id="input-area" class="terminal-input-area" style="display:none;">
      <span id="prompt" class="prompt"></span>
      <div class="input-wrapper">
        <input
          id="terminal-input"
          type="text"
          class="terminal-input"
          aria-label="Terminal command input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <span id="cursor" class="cursor-blink">█</span>
      </div>
    </div>
    <div id="mobile-bar" class="mobile-command-bar">
      <button class="mobile-cmd" data-cmd="help">help</button>
      <button class="mobile-cmd" data-cmd="ls">ls</button>
      <button class="mobile-cmd" data-cmd="lt">tree</button>
      <button class="mobile-cmd" data-cmd="ls projects/">projects</button>
      <button class="mobile-cmd" data-cmd="man ryan">man ryan</button>
      <button class="mobile-cmd" data-cmd="neofetch">neofetch</button>
      <button class="mobile-cmd" data-cmd="cat connect/*">connect</button>
    </div>
    </div>
  </div>

  <script id="podcast-data" type="application/json" set:html={podcastJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="blog-data" type="application/json" set:html={blogJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="initial-path" type="application/json" set:html={JSON.stringify(path)}></script>
  <script>
    import { boot } from '../terminal/boot';
    boot();
  </script>
</Layout>
