---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { PODCAST_RSS_URL, parsePodcastFeed } from '../../lib/podcast-rss';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { title, date, description, tags } = post.data;

// Fetch blog posts at build time (same as index.astro)
const blogPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const blogJson = JSON.stringify(blogPosts.map(post => ({
  slug: post.id.replace(/\.md$/, ''),
  title: post.data.title,
  date: post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  updated: post.data.updated?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  description: post.data.description,
  tags: post.data.tags,
  body: post.body,
})));

// Fetch podcast RSS at build time
let podcastJson = 'null';
try {
  const res = await fetch(PODCAST_RSS_URL);
  if (res.ok) {
    podcastJson = JSON.stringify(parsePodcastFeed(await res.text()));
  }
} catch (e) {
  console.error('Podcast RSS fetch failed:', e);
}

const ogTitle = `${title} — Ryan Hughes`;
const ogDescription = description || 'A blog post by Ryan Hughes';
const ogUrl = `https://ryanhughes.me/blog/${slug}`;
const ogImage = 'https://ryanhughes.me/images/og-image.png';
const publishedTime = post.data.date.toISOString();
const modifiedTime = post.data.updated?.toISOString();
---

<Layout title={ogTitle}>
  <Fragment slot="head">
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="article:published_time" content={publishedTime} />
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ryanrhughes" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <div id="crt-overlay"></div>
  <div id="terminal" class="terminal-fullscreen">
    <div id="terminal-output" class="terminal-output" role="log" aria-live="polite"></div>
    <div id="bottom-bar" class="bottom-bar">
    <div id="input-area" class="terminal-input-area" style="display:none;">
      <span id="prompt" class="prompt"></span>
      <div class="input-wrapper">
        <input
          id="terminal-input"
          type="text"
          class="terminal-input"
          aria-label="Terminal command input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <span id="cursor" class="cursor-blink">█</span>
      </div>
    </div>
    <div id="mobile-bar" class="mobile-command-bar">
      <button class="mobile-cmd" data-cmd="help">help</button>
      <button class="mobile-cmd" data-cmd="ls">ls</button>
      <button class="mobile-cmd" data-cmd="lt">tree</button>
      <button class="mobile-cmd" data-cmd="ls projects/">projects</button>
      <button class="mobile-cmd" data-cmd="man ryan">man ryan</button>
      <button class="mobile-cmd" data-cmd="neofetch">neofetch</button>
      <button class="mobile-cmd" data-cmd="cat connect/*">connect</button>
    </div>
    </div>
  </div>

  <script id="podcast-data" type="application/json" set:html={podcastJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="blog-data" type="application/json" set:html={blogJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="initial-path" type="application/json" set:html={JSON.stringify("")}></script>
  <script id="initial-reader" type="application/json" set:html={JSON.stringify(slug)}></script>
  <script>
    import { boot } from '../../terminal/boot';
    boot();
  </script>
</Layout>
