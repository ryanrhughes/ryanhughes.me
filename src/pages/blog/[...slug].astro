---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content } = await render(post);
const { title, date, description, tags } = post.data;
---

<BlogLayout title={`${title} — Ryan Hughes`} description={description} date={date} tags={tags} slug={slug}>
  <nav class="blog-nav">
    <span class="prompt">~/blog/{slug}</span>
    <a href="/blog">← blog</a>
    <a href="/">← terminal</a>
  </nav>

  <article>
    <div class="post-meta">
      <h1 class="post-title">{title}</h1>
      <div class="post-date">
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </div>
      <div class="post-description">{description}</div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
      )}
    </div>

    <div class="blog-content">
      <Content />
    </div>
  </article>

  <div class="terminal-easter-egg">
    <a href={`/?cmd=read+blog/${slug}`} class="terminal-link" title="Open in terminal reader mode">
      <span class="terminal-icon">⌨</span>
      <span>View in terminal</span>
    </a>
  </div>
</BlogLayout>
