---
import Layout from '../../layouts/Layout.astro';
import Terminal from '../../components/Terminal.astro';
import '../../styles/global.css';
import { PODCAST_RSS_URL, parsePodcastFeed } from '../../lib/podcast-rss';
import { getPublishedPosts, toBlogJson, POST_DATE_FORMAT } from '../../lib/blog-data';
import { absoluteUrl, SITE_URL } from '../../lib/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { title, description } = post.data;

const blogJson = toBlogJson(await getPublishedPosts());

// Fetch podcast RSS at build time. A silent failure here would ship the site
// with the podcast section quietly missing, so let it break the build.
const res = await fetch(PODCAST_RSS_URL);
if (!res.ok) throw new Error(`Podcast RSS fetch failed: ${res.status} ${res.statusText}`);
const podcastJson = JSON.stringify(parsePodcastFeed(await res.text()));

// The article itself, rendered for the no-JS mirror
const { Content } = await render(post);

const ogTitle = `${title} — Ryan Hughes`;
const ogDescription = description || 'A blog post by Ryan Hughes';
const canonical = absoluteUrl(`blog/${slug}`);
const ogImage = `${SITE_URL}/og/blog/${slug}.png`;
const publishedTime = post.data.date.toISOString();
const modifiedTime = post.data.updated?.toISOString();
---
<Layout
  title={ogTitle}
  description={ogDescription}
  canonical={canonical}
  ogType="article"
  image={ogImage}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>

  <noscript>
    <div class="noscript-content">
      <h1>{title}</h1>
      <p>{post.data.date.toLocaleDateString('en-US', POST_DATE_FORMAT)}</p>
      <Content />
    </div>
  </noscript>

  <Terminal />

  <script id="podcast-data" type="application/json" set:html={podcastJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="blog-data" type="application/json" set:html={blogJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="initial-path" type="application/json" set:html={JSON.stringify("")}></script>
  <script id="initial-reader" type="application/json" set:html={JSON.stringify(slug)}></script>
  <script>
    import { boot } from '../../terminal/boot';
    boot();
  </script>
</Layout>
