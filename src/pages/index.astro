---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import '../styles/global.css';
import { PODCAST_RSS_URL, parsePodcastFeed } from '../lib/podcast-rss';
import { getPageMeta } from '../lib/page-meta';
import { getPublishedPosts, toBlogJson, toBlogList } from '../lib/blog-data';

const posts = await getPublishedPosts();
const blogJson = toBlogJson(posts);

// Fetch podcast RSS at build time. A silent failure here would ship the site
// with the podcast section quietly missing, so let it break the build.
const res = await fetch(PODCAST_RSS_URL);
if (!res.ok) throw new Error(`Podcast RSS fetch failed: ${res.status} ${res.statusText}`);
const podcastData = parsePodcastFeed(await res.text());
const podcastJson = JSON.stringify(podcastData);

const meta = getPageMeta('', { podcast: podcastData, posts: toBlogList(posts) }, import.meta.env.BASE_URL);
---
<Layout title={meta.title} description={meta.description} canonical={meta.canonical}>
  <noscript>
    <div class="noscript-content" set:html={meta.noscript}></div>
  </noscript>

  <Terminal />

  <script id="podcast-data" type="application/json" set:html={podcastJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="blog-data" type="application/json" set:html={blogJson.replace(/<\/script/gi, '<\\/script')}></script>
  <script id="initial-path" type="application/json" set:html={JSON.stringify("/")}></script>
  <script>
    import { boot } from '../terminal/boot';
    boot();
  </script>
</Layout>
