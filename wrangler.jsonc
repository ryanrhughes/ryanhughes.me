{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "account_id": "29ac8c38cc3371d2f4ceda8bf3db43c1",
  "routes": [{ "pattern": "ryanhughes.me", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2025-01-06",
  "assets": {
    "directory": "./dist",
    // Without this, unmatched routes return a bare 404 with an empty body
    // instead of dist/404.html
    "not_found_handling": "404-page"
  }
}
